+
+Biquad makeHighpass(double fc, double fs) {
+  const double w = 2.0 * M_PI * fc / fs, c = cos(w);
+  const double alpha = sin(w) / (2.0 * M_SQRT1_2), a0 = 1.0 + alpha;
+  Biquad f;
+  f.b0 = (1.0 + c) / 2.0 / a0;
+  f.b1 = -(1.0 + c) / a0;
+  f.b2 = f.b0;
+  f.a1 = -2.0 * c / a0;
+  f.a2 = (1.0 - alpha) / a0;
+  return f;

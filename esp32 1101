+  f.b0 = 1.0 / (1.0 + alpha);
+  f.b1 = -2.0 * cos(w) / (1.0 + alpha);
+  f.b2 = f.b0;
+  f.a1 = f.b1;
+  f.a2 = (1.0 - alpha) / (1.0 + alpha);
